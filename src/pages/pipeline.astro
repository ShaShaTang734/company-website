---
import BaseLayout from "../layouts/BaseLayout.astro";

const pipeline = [
  {
    name: "光固化水凝胶",
    feature: "UV固化 / 10-60s成型",
    indication: "微纳加工、3D打印、生物支架",
    stage: "批量供货",
    category: "上市",
  },
  {
    name: "导电水凝胶",
    feature: "电导率0.1-10 S/m / 自修复",
    indication: "神经电极、柔性传感器、脑机接口",
    stage: "中试完成",
    category: "研发",
  },
  {
    name: "高弹性水凝胶/弹性体",
    feature: "伸长率500-1500% / 循环>1000次",
    indication: "柔性电子、可穿戴设备",
    stage: "批量供货",
    category: "上市",
  },
  {
    name: "微结构水凝胶",
    feature: "分辨率150-500μm / 保真度>90%",
    indication: "微流控、组织工程",
    stage: "小批量",
    category: "研发",
  },
  {
    name: "湿态粘附水凝胶",
    feature: "粘附强度5-20 kPa",
    indication: "组织粘合、伤口敷料、生物传感",
    stage: "小批量",
    category: "研发",
  },
];
---

<BaseLayout
  title="产品管线 — 扬州栩脉智慧科技有限公司"
  description="了解栩脉智慧在光固化水凝胶、导电水凝胶、高弹性水凝胶/弹性体、微结构水凝胶和湿态粘附水凝胶五大产品系列。"
>
  <section class="bg-primary text-white">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
      <h1 class="text-3xl md:text-4xl font-bold">产品管线</h1>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-bold text-text-main mb-2">核心产品</h2>
    <p class="text-text-muted mb-8">五大产品系列，覆盖脑机接口与生物界面材料核心需求</p>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-border">
            <th class="py-3 pr-4 font-semibold text-text-main">产品名称</th>
            <th class="py-3 pr-4 font-semibold text-text-main">核心特性</th>
            <th class="py-3 pr-4 font-semibold text-text-main">应用方向</th>
            <th class="py-3 font-semibold text-text-main">状态</th>
          </tr>
        </thead>
        <tbody>
          {pipeline.map((p) => (
            <tr class="border-b border-border">
              <td class="py-3 pr-4 text-primary font-medium">{p.name}</td>
              <td class="py-3 pr-4 text-text-secondary">{p.feature}</td>
              <td class="py-3 pr-4 text-text-secondary">{p.indication}</td>
              <td class="py-3">
                <span class={`inline-block px-2.5 py-0.5 text-xs font-medium rounded-full ${p.category === "上市" ? "bg-accent/10 text-accent" : "bg-bg-light text-text-secondary"}`}>
                  {p.stage}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
