---
import BaseLayout from "../layouts/BaseLayout.astro";

const pipeline = [
  {
    name: "新药A",
    target: "靶点A",
    indication: "非小细胞肺癌",
    stage: "临床III期",
    category: "研发",
  },
  {
    name: "新药B",
    target: "靶点B",
    indication: "类风湿关节炎",
    stage: "临床II期",
    category: "研发",
  },
  {
    name: "新药C",
    target: "靶点C",
    indication: "2型糖尿病",
    stage: "临床I期",
    category: "研发",
  },
  {
    name: "新药D",
    target: "靶点D",
    indication: "肝细胞癌",
    stage: "临床前",
    category: "研发",
  },
];
---

<BaseLayout
  title="产品管线 — 公司名称"
  description="了解公司在研产品管线和已上市产品信息。"
>
  <section class="bg-primary text-white">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
      <h1 class="text-3xl md:text-4xl font-bold">产品管线</h1>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-bold text-text-main mb-2">在研产品</h2>
    <p class="text-text-muted mb-8">专注于肿瘤、自身免疫、代谢疾病等重大疾病领域</p>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-border">
            <th class="py-3 pr-4 font-semibold text-text-main">产品</th>
            <th class="py-3 pr-4 font-semibold text-text-main">靶点</th>
            <th class="py-3 pr-4 font-semibold text-text-main">适应症</th>
            <th class="py-3 font-semibold text-text-main">阶段</th>
          </tr>
        </thead>
        <tbody>
          {pipeline.map((p) => (
            <tr class="border-b border-border">
              <td class="py-3 pr-4 text-primary font-medium">{p.name}</td>
              <td class="py-3 pr-4 text-text-secondary">{p.target}</td>
              <td class="py-3 pr-4 text-text-secondary">{p.indication}</td>
              <td class="py-3">
                <span class="inline-block px-2.5 py-0.5 text-xs font-medium rounded-full bg-bg-light text-accent">
                  {p.stage}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
