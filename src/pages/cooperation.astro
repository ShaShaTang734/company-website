---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="对外合作 — 公司名称"
  description="了解公司的合作伙伴、合作模式及合作案例。"
>
  <section class="bg-primary text-white">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
      <h1 class="text-3xl md:text-4xl font-bold">对外合作</h1>
    </div>
  </section>

  <!-- 合作模式 -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-bold text-text-main mb-8">合作模式</h2>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="border border-border rounded-lg p-6">
        <h3 class="text-lg font-semibold text-text-main mb-2">License-out</h3>
        <p class="text-text-secondary leading-relaxed">
          将自主研发项目的海外权益授权给国际合作伙伴，共同推进全球开发。
        </p>
      </div>
      <div class="border border-border rounded-lg p-6">
        <h3 class="text-lg font-semibold text-text-main mb-2">License-in</h3>
        <p class="text-text-secondary leading-relaxed">
          引进国际前沿的早期研发项目，利用公司平台优势加速开发进程。
        </p>
      </div>
      <div class="border border-border rounded-lg p-6">
        <h3 class="text-lg font-semibold text-text-main mb-2">联合研发</h3>
        <p class="text-text-secondary leading-relaxed">
          与高校、科研机构及企业建立联合实验室，共同攻克技术难题。
        </p>
      </div>
    </div>
  </section>

  <!-- 合作伙伴 -->
  <section class="bg-bg-light">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <h2 class="text-2xl font-bold text-text-main mb-8">合作伙伴</h2>
      <p class="text-text-secondary leading-relaxed max-w-3xl">
        公司与国内外多家顶尖科研机构、高校和制药企业建立了长期战略合作关系，涵盖药物发现、临床开发、商业化等多个领域。
      </p>
    </div>
  </section>
</BaseLayout>
