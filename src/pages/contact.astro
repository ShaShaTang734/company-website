---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="联系我们 — 公司名称"
  description="获取公司的联系方式、地址信息和在线留言。"
>
  <section class="bg-primary text-white">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
      <h1 class="text-3xl md:text-4xl font-bold">联系我们</h1>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-2 gap-16">
      <!-- 联系信息 -->
      <div>
        <h2 class="text-2xl font-bold text-text-main mb-8">联系方式</h2>
        <div class="space-y-6 text-text-secondary">
          <div>
            <p class="text-text-muted text-sm mb-1">公司地址</p>
            <p>中国 · XX省XX市XX区XX路XX号</p>
          </div>
          <div>
            <p class="text-text-muted text-sm mb-1">联系电话</p>
            <p>000-0000-0000</p>
          </div>
          <div>
            <p class="text-text-muted text-sm mb-1">电子邮箱</p>
            <p>contact@company.com</p>
          </div>
          <div>
            <p class="text-text-muted text-sm mb-1">商务合作</p>
            <p>bd@company.com</p>
          </div>
          <div>
            <p class="text-text-muted text-sm mb-1">媒体咨询</p>
            <p>pr@company.com</p>
          </div>
        </div>
      </div>

      <!-- 留言表单 -->
      <div>
        <h2 class="text-2xl font-bold text-text-main mb-8">在线留言</h2>
        <form class="space-y-5">
          <div>
            <label class="block text-sm text-text-secondary mb-1.5">姓名</label>
            <input
              type="text"
              class="w-full border border-border rounded px-4 py-2.5 text-text-main focus:outline-none focus:border-primary transition-colors"
              placeholder="请输入您的姓名"
            />
          </div>
          <div>
            <label class="block text-sm text-text-secondary mb-1.5">邮箱</label>
            <input
              type="email"
              class="w-full border border-border rounded px-4 py-2.5 text-text-main focus:outline-none focus:border-primary transition-colors"
              placeholder="请输入您的邮箱"
            />
          </div>
          <div>
            <label class="block text-sm text-text-secondary mb-1.5">留言内容</label>
            <textarea
              rows="4"
              class="w-full border border-border rounded px-4 py-2.5 text-text-main focus:outline-none focus:border-primary transition-colors resize-none"
              placeholder="请输入您的留言……"
            ></textarea>
          </div>
          <button
            type="submit"
            class="bg-primary text-white px-8 py-2.5 rounded font-medium hover:bg-primary-light transition-colors"
          >
            提交留言
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
