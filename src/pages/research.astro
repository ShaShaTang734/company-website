---
import BaseLayout from "../layouts/BaseLayout.astro";

const platforms = [
  {
    title: "水凝胶材料平台",
    desc: "开发具有优异生物相容性、可调的力学性能和导电性能的多功能水凝胶体系，涵盖光固化、导电、微结构、粘附和自修复等方向。固化时间10-60s，生物相容性>90%，分辨率150-500μm。",
  },
  {
    title: "弹性体材料平台",
    desc: "自主研发高拉伸、耐疲劳弹性体材料，断裂伸长率可达500-1500%，循环疲劳寿命>1000次，回复率>90%。为柔性电子和可穿戴设备提供可靠材料方案。",
  },
  {
    title: "脑机接口应用平台",
    desc: "以脑机接口为终极目标，开发神经电极界面材料、柔性神经探针等前沿应用。导电水凝胶电导率0.1-10 S/m，信号稳定性>95%，具备自修复能力。",
  },
];
---

<BaseLayout
  title="科学研发 — 扬州栩脉智慧科技有限公司"
  description="了解栩脉智慧在水凝胶材料、弹性体材料和脑机接口应用三大研发平台的核心技术优势。"
>
  <section class="bg-primary text-white">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
      <h1 class="text-3xl md:text-4xl font-bold">科学研发</h1>
    </div>
  </section>

  <!-- 研发平台 -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-bold text-text-main mb-8">研发平台</h2>
    <div class="grid md:grid-cols-3 gap-8">
      {platforms.map((p) => (
        <div class="border border-border rounded-lg p-6">
          <h3 class="text-lg font-semibold text-text-main mb-3">{p.title}</h3>
          <p class="text-text-secondary leading-relaxed">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 技术优势 -->
  <section class="bg-bg-light">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <h2 class="text-2xl font-bold text-text-main mb-8">技术优势</h2>
      <div class="max-w-3xl space-y-4">
        <div class="flex gap-3">
          <span class="text-accent font-bold">01</span>
          <div>
            <h3 class="font-semibold text-text-main">快速光固化技术</h3>
            <p class="text-text-secondary">UV光固化10-60秒成型，支持微米级精密加工，可定制化设计与批量化生产。</p>
          </div>
        </div>
        <div class="flex gap-3">
          <span class="text-accent font-bold">02</span>
          <div>
            <h3 class="font-semibold text-text-main">优异生物相容性</h3>
            <p class="text-text-secondary">细胞存活率>90%，通过第三方生物相容性检测认证，满足医疗级应用需求。</p>
          </div>
        </div>
        <div class="flex gap-3">
          <span class="text-accent font-bold">03</span>
          <div>
            <h3 class="font-semibold text-text-main">多功能集成</h3>
            <p class="text-text-secondary">导电、粘附、自修复、高弹性等多功能一体化设计，满足脑机接口复杂应用场景。</p>
          </div>
        </div>
        <div class="flex gap-3">
          <span class="text-accent font-bold">04</span>
          <div>
            <h3 class="font-semibold text-text-main">可定制化开发</h3>
            <p class="text-text-secondary">力学性能、电学性能、光学性能均可按客户需求定制调整，提供从材料到器件的整体方案。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 研发成果 -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-bold text-text-main mb-8">研发成果</h2>
    <div class="max-w-3xl text-text-secondary leading-relaxed space-y-4">
      <p>公司已建立覆盖光固化水凝胶、导电水凝胶、高弹性水凝胶/弹性体、微结构水凝胶、湿态粘附水凝胶五大产品系列。</p>
      <p>导电水凝胶已完成中试放大验证，各项性能指标达到产业化标准，具备批量供货能力。</p>
      <p>多项产品通过第三方生物相容性检测，细胞存活率稳定高于90%。</p>
    </div>
  </section>
</BaseLayout>
